# Gemini API key from https://aistudio.google.com/apikey (never commit the real one)
GEMINI_API_KEY=your_gemini_api_key

# Password users type to enter the app. Different from the Gemini key. Use a long random value.
APP_ACCESS_KEY=your_private_app_access_key

# Optional overrides (defaults shown)
# CV_PATH=cv.pdf
# EMBEDDING_MODEL=gemini-embedding-001
# CHAT_MODEL=gemini-3.1-flash-lite
# CHAT_FALLBACK_MODEL=gemini-3-flash-preview   # used if CHAT_MODEL is overloaded/unavailable; empty = disabled
# CHUNK_SIZE=700
# CHUNK_OVERLAP=120
# TOP_K=4
# MIN_SCORE=0.0
# MAX_FAILED_ATTEMPTS=5
# LOCKOUT_SECONDS=300
# MAX_QUESTIONS_PER_USER=10   # per browser session; a page refresh starts a new session
# SHOW_ADMIN_TOOLS=true       # shows the 'Test Gemini connection' button (keep off on the public deployment)
# MAX_DAILY_QUESTIONS=200   # total across all visitors per day (server local time); caps token spend
